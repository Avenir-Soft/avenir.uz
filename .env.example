# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:replace_with_real_bot_token

# Comma-separated Telegram user/group IDs that should receive each application
# Example: 123456789,-1009876543210
TELEGRAM_CHAT_IDS=111111111,222222222

# Optional Telegram API base (useful if your server cannot reach api.telegram.org directly)
# TELEGRAM_API_BASE=https://api.telegram.org

# Optional transport tuning
# TELEGRAM_REQUEST_TIMEOUT_MS=10000
# TELEGRAM_RETRY_COUNT=2

# Public website URL for SEO metadata/sitemap/robots
NEXT_PUBLIC_SITE_URL=https://avenir.uz

# Google Analytics 4 measurement ID (example: G-XXXXXXXXXX)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional Google Search Console verification token
# GOOGLE_SITE_VERIFICATION=verification_token_here
